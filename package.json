{
  "name": "watch-people-die-live",
  "version": "1.0.0",
  "description": "World map of Crude Death Rate (deaths per 1,000 population) from the UN Data Portal API, rendered with D3.",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "build:density": "node scripts/build-density.mjs",
    "build:mortality": "node scripts/build-mortality.mjs",
    "build:causes": "node scripts/build-causes.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "d3": "^7.9.0",
    "express": "^4.21.2",
    "i18n-iso-countries": "^7.14.0",
    "three": "^0.184.0",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  }
}
